APP_NAME=We Eat API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Neon pooled connection converted for SQLAlchemy asyncpg.
# Example: postgresql+asyncpg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=15
DB_COMMAND_TIMEOUT_SECONDS=30
CHECK_DATABASE_ON_STARTUP=true

JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=10080
OTP_PEPPER=
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT=3

# Comma-separated, exact frontend origins only.
CORS_ORIGINS=http://localhost:3000

# log = print OTP to backend logs for local development; smtp = send real email.
EMAIL_MODE=smtp
EMAIL_REPLY_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=baisakh2015@gmail.com
SMTP_PASSWORD=
SMTP_KEY=
SMTP_PROVIDER=gmail
SMTP_FROM_EMAIL=baisakh2015@gmail.com
SMTP_FROM_NAME=We Eat
SMTP_START_TLS=true
SMTP_USE_TLS=false
SMTP_REQUIRE_AUTH=true
SMTP_TIMEOUT_SECONDS=20

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=we-eat
MAX_UPLOAD_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/jpg

# Optional initial admin bootstrap script variables.
ADMIN_EMAIL=baisakh2015@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin
