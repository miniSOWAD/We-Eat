APP_NAME=We Eat API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Paste the Neon connection string exactly as Neon provides it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_SSL_MODE=require
DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=15
DB_COMMAND_TIMEOUT_SECONDS=30
CHECK_DATABASE_ON_STARTUP=true

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=10080
OTP_PEPPER=replace-with-a-different-random-secret
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT=3

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Recommended: send directly through your own mailbox SMTP service.
# Gmail example: SMTP_HOST=smtp.gmail.com and use a Google App Password.
# Outlook example: SMTP_HOST=smtp.office365.com.
# Legacy names MAIL_SERVER, MAIL_USERNAME, MAIL_PASSWORD and MAIL_FROM are also accepted.
EMAIL_MODE=smtp
EMAIL_REPLY_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-mail-provider-app-password
SMTP_KEY=
SMTP_PROVIDER=gmail
SMTP_FROM_EMAIL=your-address@gmail.com
SMTP_FROM_NAME=We Eat
SMTP_START_TLS=true
SMTP_USE_TLS=false
SMTP_REQUIRE_AUTH=true
SMTP_TIMEOUT_SECONDS=20

# Optional alternative. Brevo is not required.
BREVO_API_KEY=

# Configure either CLOUDINARY_URL or all three individual variables.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=we-eat
MAX_UPLOAD_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=We Eat Admin
