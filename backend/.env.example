APP_NAME=We Eat API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Neon pooled connection converted for SQLAlchemy asyncpg.
# Example: postgresql+asyncpg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=10080
OTP_PEPPER=replace-with-a-different-random-secret
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT=3

# Comma-separated, exact frontend origins only.
CORS_ORIGINS=http://localhost:3000

# log = print OTP to backend logs for local development; smtp = send real email.
EMAIL_MODE=log
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=We Eat
SMTP_START_TLS=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=we-eat
MAX_UPLOAD_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Optional initial admin bootstrap script variables.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=We Eat Admin
