APP_NAME=We Eat API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Paste the Neon connection string exactly as Neon provides it.
# Both postgresql:// and postgresql+asyncpg:// are accepted.
# The application automatically selects asyncpg and removes channel_binding.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_SSL_MODE=require
DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=15
DB_COMMAND_TIMEOUT_SECONDS=30
CHECK_DATABASE_ON_STARTUP=true

# Generate two different random secrets. Do not reuse these example values.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=10080
OTP_PEPPER=replace-with-a-different-random-secret
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT=3

# Comma-separated exact frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# log = print OTP in the backend terminal for local development.
# smtp = send the OTP through your mail provider.
EMAIL_MODE=log
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=We Eat
SMTP_START_TLS=true
SMTP_TIMEOUT_SECONDS=20

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=we-eat
MAX_UPLOAD_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Optional admin bootstrap values used by scripts/create_admin.py.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=We Eat Admin
